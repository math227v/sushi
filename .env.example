# Sushi Counter configuration — used by docker-compose (env_file) and `npm start`.

# Port the server listens on (and the host port in docker-compose)
PORT=8080

# Where the SQLite database lives. Inside Docker this should stay /data/sushi.db
# (the compose volume). For local `npm start` it falls back to server/sushi.db.
# DB_PATH=/data/sushi.db

# Session signing secret for Better Auth (32+ random bytes).
# If you remove this line, the server generates one and stores it next to the DB.
BETTER_AUTH_SECRET=change-me-generate-with: openssl rand -base64 32

# The public origin the app is served from. Change these if you host it
# somewhere else. Requests from origins not listed here are rejected.
BETTER_AUTH_URL=https://sushi.app.mtlr.it
TRUSTED_ORIGINS=https://sushi.app.mtlr.it,https://sushi.mtlr.dk,http://localhost:8080

NODE_ENV=production
